# ── LLM Provider ──
# Options: mock | gemini | groq
# "mock" works without any API key (deterministic fallback responses)
LLM_PROVIDER=mock

# Google Gemini (free — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (free — https://console.groq.com/keys)
GROQ_API_KEY=

# ── Data Enrichment (optional, improves accuracy to 90%+) ──

# Apollo.io (free tier: 10,000 credits/month — https://app.apollo.io → Settings → API Keys)
# Provides: verified emails, phone numbers, employee count, industry
APOLLO_API_KEY=

# Hunter.io (free tier: 25 searches/month — https://hunter.io/api-keys)
# Provides: verified work emails from company domains
HUNTER_API_KEY=

# ── Supabase (required for persistent storage) ──
# Create a project at https://supabase.com → Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
